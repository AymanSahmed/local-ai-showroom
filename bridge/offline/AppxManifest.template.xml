<?xml version="1.0" encoding="utf-8"?>
<!--
  Loose-layout package identity for the OFFLINE bundle (scripts/build-offline-bundle.ps1 fills in the {{placeholders}}).
  Registered on the target PC with Add-AppxPackage -Register (Developer Mode on); no signing, no internet, no NuGet.
  The identity name differs from the dev package (Package.appxmanifest) so both can coexist on one PC.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap uap5 rescap systemai">

  <Identity Name="LocalAIShowroom.Bridge.Offline" Publisher="CN=LocalAIShowroom" Version="{{VERSION}}" ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>Local AI Showroom Bridge (offline)</DisplayName>
    <PublisherDisplayName>Local AI Showroom (demo)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26226.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="{{RUNTIME_MIN}}" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="LocalAIShowroom.Bridge.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Local AI Showroom Bridge"
        Description="Local bridge between the Local AI Showroom web app and Windows on-device AI."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="LocalAIShowroomBridge.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>Microsoft.Windows.AI.MachineLearning.dll</Path>
        <ActivatableClass ActivatableClassId="Microsoft.Windows.AI.MachineLearning.ExecutionProviderCatalog" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="Microsoft.Windows.AI.MachineLearning.ModelCatalog" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="Microsoft.Windows.AI.MachineLearning.ModelCatalogSource" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
</Package>
